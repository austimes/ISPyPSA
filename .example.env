# Copy to .env (gitignored) and edit for this machine.

# Root of every input and run product. The same storage is mounted on both hosts:
#   workstation:  //fs1-cbr.nexus.csiro.au/{en-pathways}/work/AusTIMES2/data/ispypsa
#   petrichor:    /datasets/work/en-pathways/work/AusTIMES2/data/ispypsa
IO_DIR=//fs1-cbr.nexus.csiro.au/{en-pathways}/work/AusTIMES2/data/ispypsa

# Optional. Input package to read instead of the newest one under $IO_DIR/inputs, either a
# directory name there or an absolute path.
# MSM_INPUTS=2026-09-17T13.54_isp2026_final

# Cluster submissions (petrichor only). The two paths are per-user: put your own
# licence file and cache directory in place of the <user> placeholders.
MSM_SLURM_ACCOUNT=OD-241887
MSM_SLURM_PARTITION=defq
GRB_LICENSE_FILE=/home/<user>/gurobi.lic
UV_CACHE_DIR=/scratch3/<user>/uv_cache
